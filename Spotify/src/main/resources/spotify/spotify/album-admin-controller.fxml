<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="709.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spotify.spotify.controller.AlbumAdminController">
   <children>
      <VBox layoutX="31.0" layoutY="22.0" prefHeight="367.0" prefWidth="308.0">
         <children>
            <Label text="Albume" />
            <TableView fx:id="table" prefHeight="318.0" prefWidth="308.0">
              <columns>
                <TableColumn fx:id="colId" prefWidth="75.0" text="Id" />
                <TableColumn fx:id="colDenumire" prefWidth="151.0" text="Denumire" />
                <TableColumn fx:id="colAnAparitie" prefWidth="82.0" text="An Aparitie" />
              </columns>
            </TableView>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onAddEdit" prefHeight="25.0" prefWidth="65.0" text="Add/Edit" />
                  <Button mnemonicParsing="false" onAction="#onDelete" prefHeight="25.0" prefWidth="65.0" text="Delete" />
                  <Button mnemonicParsing="false" onAction="#onRefresh" prefHeight="25.0" prefWidth="65.0" text="Refresh" />
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox layoutX="406.0" layoutY="22.0" prefHeight="367.0" prefWidth="268.0">
         <children>
            <Label text="Melodii" />
      
                   <TableView fx:id="tableMelodii" prefHeight="319.0" prefWidth="269.0">
                 <columns>
                     <TableColumn fx:id="melodieId" prefWidth="75.0" text="Id" />
                     <TableColumn fx:id="melodieDenumire" prefWidth="122.0" text="Denumire" />
                     <TableColumn fx:id="melodieAnAparitie" prefWidth="71.0" text="An aparitie" />
                 </columns>
             </TableView>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button mnemonicParsing="false" text="Add/Edit" fx:id="btnAddMelodie" onAction="#onMelodieAddEdit"/>
                  <Button mnemonicParsing="false" text="Delete" fx:id="btnDeleteMelodie" onAction="#onMelodieDelete"/>
                  <Button mnemonicParsing="false" text="Refresh" fx:id="btnRefreshMelodie" onAction="#onMelodieRefresh"/>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
